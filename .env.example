# Gemini API Key (Optional / Future expansion)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail Account Information (IMAP SSL)
GMAIL_USER=your_email@gmail.com
# 16-character App Password generated from Google Account (without spaces)
# Route: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=your_app_password_here

# Target Gmail Label
GMAIL_LABEL=News

# Newspaper Publication Info
NEWSPAPER_NAME=Mars Tech Daily
NEWSPAPER_EDITION=Mars 에디션
NEWSPAPER_PUBLISHER=LeeJaeHoon

# Daily Schedule Time (HH:MM in KST)
SCHEDULE_TIME=08:00
